# Application
APP_NAME=ai-pre-pr-review-api
DEBUG=false
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pre_pr_review

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT — use the same secret the NextAuth JWT session uses (e.g. NEXTAUTH_SECRET)
JWT_SECRET=change-me-to-a-long-random-string-matching-nextauth
JWT_ALGORITHM=HS256

# Fernet key for encrypting GitHub tokens at rest (32 url-safe base64 bytes)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# CORS — comma-separated origins (Next.js app)
CORS_ORIGINS=http://localhost:3000

# OpenAI (code review)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# GitHub (optional default user agent)
GITHUB_API_USER_AGENT=ai-pre-pr-review-backend
